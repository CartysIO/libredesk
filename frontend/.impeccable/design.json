      "css": ".ds-rail{width:48px;height:200px;background:#0E2F21;display:flex;flex-direction:column;align-items:center;gap:6px;padding-top:12px} .ds-mark{width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:#64C47C;border-radius:4px;margin-bottom:6px} .ds-ri{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:4px;color:#AFCABA;transition:background-color .15s,color .15s} .ds-ri:hover{background:#1E4835;color:#fff} .ds-ri:focus-visible,.ds-mark:focus-visible{outline:2px solid #64C47C;outline-offset:1px} .ds-on{background:#1E4835;color:#fff}"
