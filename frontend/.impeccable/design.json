      "html": "<a class=\"ds-lr\" href=\"#\"><span class=\"ds-sw\"></span><span class=\"ds-lr-c\"><span class=\"ds-lr-1\"><b>Dana Levi</b><span class=\"ds-meta\">2m</span></span><span class=\"ds-lr-s\">Card declined at vendor</span><span class=\"ds-lr-3\"><span class=\"ds-snip\">Hi team, the card ending 4421 was declined again this morning</span><span class=\"ds-unread\">2</span></span></span></a>",
      "css": ".ds-lr{display:flex;gap:10px;padding:8px 12px;border-bottom:1px solid rgba(224,230,227,.7);background:#fff;text-decoration:none;color:#0F1F1A;font-family: Urbanist, ui-sans-serif, system-ui, sans-serif;width:340px;transition:background-color .15s ease-in-out} .ds-lr:hover{background:rgba(235,241,238,.5)} .ds-lr:focus-visible{outline:2px solid #41AA5E;outline-offset:-2px} .ds-sw{width:8px;height:8px;border-radius:1px;background:#E63F19;margin:6px 4px 0;flex:none} .ds-lr-c{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px} .ds-lr-1,.ds-lr-3{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:14px} .ds-lr-1 b{font-weight:700} .ds-meta{font-size:12px;color:#54645F;font-variant-numeric:tabular-nums} .ds-lr-s{font-size:14px} .ds-snip{font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .ds-unread{min-width:20px;height:20px;padding:0 4px;border-radius:9999px;background:#0F1F1A;color:#FCFDFC;font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;flex:none}"
    },
    {
      "name": "Folded thread row",
      "kind": "custom",
      "refersTo": "fold-row",
      "description": "One-line folded email: avatar, sender, snippet, time. Click expands.",
      "html": "<button class=\"ds-fold\" type=\"button\"><span class=\"ds-av\">DL</span><span class=\"ds-name\">Dana Levi</span><span class=\"ds-snip\">Thanks, that worked. One more question about the receipt sync</span><span class=\"ds-meta\">Oct 12</span></button>",
      "css": ".ds-fold{display:flex;align-items:center;gap:12px;width:480px;padding:8px 16px;border:0;border-bottom:1px solid rgba(224,230,227,.7);background:#fff;text-align:left;font-family: Urbanist, ui-sans-serif, system-ui, sans-serif;cursor:pointer;transition:background-color .15s} .ds-fold:hover{background:rgba(235,241,238,.5)} .ds-fold:focus-visible{outline:none;background:#EBF1EE} .ds-av{width:24px;height:24px;border-radius:9999px;background:#F2F5F4;font-size:10px;font-weight:600;display:flex;align-items:center;justify-content:center;flex:none} .ds-name{width:144px;flex:none;font-size:14px;font-weight:600;color:#0F1F1A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .ds-snip{flex:1;min-width:0;font-size:14px;color:#54645F;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .ds-meta{font-size:12px;color:#54645F;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Ticket header",
