      "html": "<div class=\"ds-lane\"><div class=\"ds-lh\"><span class=\"ds-sw\"></span>On customer</div><div class=\"ds-bc\" tabindex=\"0\"><div class=\"ds-bc1\"><span class=\"ds-sw\"></span><b>#1038</b><span class=\"ds-dot\"></span></div><div class=\"ds-bcs\">Buildium sync stuck on bill</div></div></div>",
      "css": ".ds-lane{width:288px;border-right:1px solid rgba(224,230,227,.7);padding:12px;font-family: Urbanist, ui-sans-serif, system-ui, sans-serif;color:#0F1F1A} .ds-lh{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;margin-bottom:8px} .ds-sw{width:8px;height:8px;border-radius:1px;background:#246ADB;flex:none} .ds-bc{border:1px solid #E0E6E3;border-radius:4px;background:#fff;padding:10px 12px;cursor:pointer;transition:background-color .15s,border-color .15s} .ds-bc:hover{border-color:#CDD6D1;background:rgba(235,241,238,.4)} .ds-bc:focus-visible{outline:2px solid #41AA5E;outline-offset:2px} .ds-bc1{display:flex;align-items:center;gap:8px;font-size:12px;font-variant-numeric:tabular-nums} .ds-dot{width:8px;height:8px;border-radius:9999px;background:#0F1F1A} .ds-bcs{font-size:14px;margin-top:4px}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "rail",
      "description": "48px deep-green icon rail with the Clyr mark.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-mark\" href=\"#\" aria-label=\"Inbox\"><svg viewBox=\"0 0 33 43\" width=\"18\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M0 23.2459C0.103363 22.231 0.197423 21.2151 0.312156 20.2013C0.785559 15.9882 1.91428 11.9739 4.0725 8.28719C6.02399 4.95278 9.02981 2.88106 12.5452 1.43712C17.7268 -0.690915 22.8412 -0.371404 27.9049 1.8447C28.6759 2.18265 29.4357 2.5421 30.1044 3.06233C30.7856 3.59075 30.8517 4.01574 30.3587 4.71929C29.1907 6.38546 28.0227 8.05164 26.8527 9.71574C26.3575 10.4203 26.0175 10.4736 25.2578 10.0865C20.6778 7.7526 16.1411 7.76999 11.6294 10.3118C5.61157 13.7025 2.30396 19.04 0.480638 25.4589C0.402082 25.7375 0.366938 26.0273 0.291483 26.3068C0.246004 26.4738 0.266677 26.7031 0.00103363 26.7267C0 25.5664 0 24.4062 0 23.2459Z\"/><path fill=\"currentColor\" fill-opacity=\"0.6\" d=\"M32.4952 25.352C32.5086 25.607 32.3443 25.7934 32.2223 25.9849C29.939 29.5364 26.7141 31.8191 22.6509 32.9763C18.8812 34.0505 15.277 33.4975 11.7626 31.9379C8.22349 30.368 5.76036 27.7464 4.12826 24.3054C3.79956 23.6122 3.47397 22.9168 3.2228 22.1897C3.14115 21.9531 3.14424 21.7473 3.25898 21.5087C4.46522 18.9833 6.06735 16.7467 8.14084 14.8491C8.22557 14.7713 8.30829 14.6227 8.42919 14.6781C8.55737 14.7364 8.54599 14.9095 8.58007 15.0416C10.1357 21.1584 13.9415 25.2025 20.0503 26.9465C24.1704 28.1222 28.1881 27.6531 31.9628 25.5456C32.0972 25.4708 32.2358 25.4022 32.3753 25.3356C32.399 25.3244 32.4373 25.3428 32.4972 25.3531L32.4952 25.352Z\"/></svg></a><a class=\"ds-ri ds-on\" href=\"#\" aria-label=\"Conversations\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg></a><a class=\"ds-ri\" href=\"#\" aria-label=\"Contacts\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=