  "components": [
    {
      "name": "Whose-move swatch",
      "kind": "custom",
      "refersTo": "status-swatch",
      "description": "8px square in the status code colour; filled = someone must act, hollow = resolved.",
      "html": "<span class=\"ds-row\"><span class=\"ds-sw ds-new\"></span>New</span><span class=\"ds-row\"><span class=\"ds-sw ds-you\"></span>On you</span><span class=\"ds-row\"><span class=\"ds-sw ds-cust\"></span>On customer</span><span class=\"ds-row\"><span class=\"ds-sw ds-hold\"></span>On hold</span><span class=\"ds-row\"><span class=\"ds-sw ds-done ds-hollow\"></span>Resolved</span>",
      "css": ".ds-row{display:inline-flex;align-items:center;gap:8px;margin-right:16px;font-family: Urbanist, ui-sans-serif, system-ui, sans-serif;font-size:14px;font-weight:600;color:#0F1F1A} .ds-sw{width:8px;height:8px;border-radius:1px;background:currentColor;display:inline-block} .ds-new{color:#2E8A48} .ds-you{color:#E63F19} .ds-cust{color:#246ADB} .ds-hold{color:#6E7D91} .ds-done{color:#96A69F} .ds-hollow{background:transparent;box-shadow:inset 0 0 0 1.5px currentColor}"
    },
    {
      "name": "Conversation list row",
      "kind": "card",
