  "narrative": {
    "northStar": "The Identity Manual Desk",
    "overview": "Clyr's identity manual applied to a support desk: one strict grid, flush-left Urbanist, and colour used only as a code for whose move it is. A deep Clyr-green rail holds navigation. Next to it, white work panes meet on 1px hairlines over a faintly green-tinted ground. Nothing floats: no gutters, no rounded pane cards, no pane shadows.\n\nDensity is high but scannable. The agent reads rows by their coded swatch, opens a ticket whose reference number is the headline, and reads the newest email first, with older messages folded to one-line rows. Chrome (headers, recipients, quoted history, signatures) stays out of view until asked for.\n\nThe system rejects the grey shadcn admin with one green accent. Green is identity (rail, mark, primary action), and the whose-move code is the only other colour family in the chrome.",
    "keyCharacteristics": [
      "Deep green rail (48px) with the Clyr \"C\" mark; everything else is light panes on hairlines.",
      "One five-value whose-move code, shown as an 8px square swatch, filled or hollow.",
      "Three type sizes (12 / 14 / 16), Urbanist only, rank by weight and case.",
      "Tabular figures for every number, time and reference.",
      "Gmail-style email thread: folded rows, newest open.",
      "Unread, priority and counts are neutral; they never borrow a code colour."
    ],
    "rules": [
      {
        "name": "The Whose-Move Rule",
        "body": "The five code colours mean whose move it is, and they appear only on a status swatch. Other colour in the chrome is limited to brand green (identity) and the upstream semantic states (SLA badges, errors and delete, private-note amber).",
        "section": "colors"
      },
      {
        "name": "The Neutral Signal Rule",
        "body": "Unread counts, unread dots and priority markers are neutral (`foreground` or `muted-foreground`). The unread count is a `foreground` pill with `background` text; the board unread dot is `foreground`; priority is the bar count of `PriorityIcon` (low 1 bar muted, medium 2 bars, high 3 bars in `foreground`), never red or amber.",
        "section": "colors"
      },
      {
        "name": "The One-Token-Name Rule",
        "body": "The desk restyles upstream by giving upstream token names new values under `html[data-app='desk']`. Do not fork a component to recolour it.",
        "section": "colors"
      },
      {
        "name": "The Three Sizes Rule",
        "body": "The desk uses 12, 14 and 16px. Rank comes from weight (400 / 500 / 600 / 700) and case, not size.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every reference number, time, count and date uses `tabular-nums`.",
        "section": "typography"
      },
      {
        "name": "The Hairline Pane Rule",
        "body": "Panes are separated by one 1px `border` line, never by a gutter, a rounded card or a shadow.",
        "section": "layout"
      },
      {
        "name": "The Flat Pane Rule",
        "body": "If it is part of the page, it has no shadow. Only overlays (menus, popovers, dialogs, the board drawer) lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show ticket state with `StatusSwatch` and `statusCode()`, filled for every status but Resolved.",
      "Do keep chrome to 12, 14 and 16px Urbanist; rank with weight and case.",
      "Do use `tabular-nums` on every reference, time, date and count.",
      "Do separate panes, rows and sections with one 1px `border` line.",
      "Do keep unread and priority neutral (`foreground` / `muted-foreground`).",
      "Do scope new desk styling under `html[data-app='desk']` and reuse upstream token names, so rebases on upstream stay easy.",
      "Do keep incoming email on a light canvas in dark mode (`.dark .email-light-canvas`: white, #1a1a1a text, `color-scheme: light`). Sender colours in email HTML are only legible on white. This is a deliberate exception to the theme."
    ],
    "donts": [
      "Don't put a code colour on anything that is not a status swatch: no coloured chips, coloured left bars, coloured row tints or coloured lane fills.",
      "Don't colour unread counts, unread dots or priority markers.",
      "Don't add a fourth type size or a display tier.",
      "Don't float panes: no gutters, rounded pane cards or pane shadows.",
      "Don't fill a light-mode button with brand green #62C47A; white text fails on it. Use `primary`.",
      "Don't hide a signature without a Gmail or Outlook marker. Signatures are only detected by those markers, never guessed.",
      "Don't restyle the chat widget or the help center with desk tokens; they follow the upstream system below."
    ]
  }
}
